# Node 24+. Generate a long random management password; never put provider keys in VITE_*.
PERFORMER_ADMIN_TOKEN=
PERFORMER_DATA_DIR=./data
PERFORMER_HOST=127.0.0.1
PERFORMER_PORT=8091
# Absolute path to the existing AR build. API and web UI are served on the same origin.
WEB_DIST=../ar-engine/dist
COOKIE_SECURE=0
TRIPO_API_KEY=
TRIPO_UPLOAD_PATH=/upload/sts
TRIPO_MODEL_VERSION=v2.5-20250123
DEEP_MOTION_CLIENT_ID=
DEEP_MOTION_CLIENT_SECRET=
# Use the production base URL actually supplied by DeepMotion. No invented default.
DEEP_MOTION_BASE_URL=
BLENDER_PATH=
# Additional trusted provider artifact hostnames, comma-separated (not user input).
ARTIFACT_HOSTS=
